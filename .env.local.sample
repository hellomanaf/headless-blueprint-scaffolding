# Your WordPress site URL (must have WPGraphQL + WPGraphQL for WooCommerce)
NEXT_PUBLIC_WORDPRESS_URL=https://faustexample.wpengine.com

# Plugin secret found in WordPress Settings->Headless
# FAUST_SECRET_KEY=YOUR_PLUGIN_SECRET

# The URL of your site, used by Faust for sitemap generation, however you can name this whatever you want.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: secret for on-demand ISR without a full WP Engine rebuild
# POST /api/revalidate?secret=YOUR_SECRET&path=/
# REVALIDATE_SECRET=change-me

# Required WordPress plugins for shop + cart/checkout/account:
# - WooCommerce
# - WPGraphQL
# - WPGraphQL for WooCommerce (WooGraphQL)
# - Faust.js (Headless)
# - WPGraphQL JWT Authentication (required for My Account login)
#
# WooCommerce / WordPress setup tips:
# - Settings → General → enable “Anyone can register”
# - WooCommerce → Settings → Accounts: allow account creation
# - Enable at least one payment method (e.g. Cash on delivery) for checkout
# - Usernames cannot contain “@” (email local-part is used automatically)